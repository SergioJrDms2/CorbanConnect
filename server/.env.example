# ─── HTTP ────────────────────────────────────────────────────────
PORT=8080

# ─── Supabase (service role: o backend faz inserts em notification_log) ─
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── WhatsApp (Baileys) ──────────────────────────────────────────
# Pasta onde as credenciais do WhatsApp Web ficam salvas depois do QR.
# NUNCA commitar. Faça backup periódico se não quiser parear toda hora.
AUTH_DIR=./auth_baileys

# ─── E-mail (Nodemailer / SMTP) ──────────────────────────────────
# Qualquer SMTP serve: Gmail (com App Password), Zoho, Sendgrid SMTP,
# AWS SES SMTP, Migadu, Fastmail, servidor próprio etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=app-password-aqui
EMAIL_FROM="Starbank · Corban Connect <nao-responder@starbank.com.br>"

# ─── Plataforma ──────────────────────────────────────────────────
# Usado para gerar os links de status/opt-out nas mensagens.
CORBAN_CONNECT_BASE_URL=https://app.corbanconnect.com.br

# ─── Régua / scheduler ───────────────────────────────────────────
# Horário comercial (América/São_Paulo). Fora disso, nada dispara.
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=20
# Cron de execução do scheduler. Default: de hora em hora.
RULER_CRON="0 * * * *"
# Limita quantos contratos o scheduler avalia por execução.
RULER_BATCH_SIZE=500
# Delay aleatório (ms) entre disparos consecutivos para reduzir risco de ban.
DISPATCH_MIN_DELAY_MS=5000
DISPATCH_MAX_DELAY_MS=15000

# ─── Segurança ───────────────────────────────────────────────────
# Token necessário em chamadas /send/* e /dispatch vindas do front
# ou de ferramentas internas. Gere um valor aleatório longo.
INTERNAL_API_TOKEN=troque-por-uma-string-aleatoria-longa
